# Copia este archivo como .env.local (para desarrollo local)
# y agrega las mismas variables en Vercel: Settings -> Environment Variables

# La encuentras en Supabase: Project Settings -> API -> Project URL
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# La encuentras en Supabase: Project Settings -> API -> service_role (secret)
# IMPORTANTE: nunca la publiques ni la subas a GitHub. Solo se usa en el servidor.
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key-aqui
