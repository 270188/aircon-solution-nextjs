# Variables del backend en producción (no subas el archivo real a GitHub)
SPRING_PROFILES_ACTIVE=prod
# Formato JDBC. Ejemplo con Supabase (Project Settings -> Database -> Connection string -> JDBC):
DATABASE_URL=jdbc:postgresql://db.TU-PROYECTO.supabase.co:5432/postgres?sslmode=require
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=tu-contraseña
ADMIN_USERNAME=admin
ADMIN_PASSWORD=una-contraseña-larga-y-segura
ALLOWED_ORIGINS=https://airconsolutionsac.com,https://www.airconsolutionsac.com
BOOKING_SLOT_CAPACITY=2
RATE_LIMIT_PER_MINUTE=10
# Facturación electrónica directa con SUNAT (ver docs/SUNAT.md)
INVOICE_PROVIDER=SUNAT
SUNAT_MODE=BETA
SUNAT_SOL_USER=
SUNAT_SOL_PASSWORD=
SUNAT_CERT_BASE64=
SUNAT_CERT_PASSWORD=
